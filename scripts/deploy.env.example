# Copier vers scripts/deploy.env (non commité) et renseigner.
#
# Les deux valeurs se trouvent dans App Store Connect →
# Utilisateurs et accès → Intégrations → Clés :
#   - ASC_KEY_ID    : la colonne « ID de clé » de la ligne
#   - ASC_ISSUER_ID : l'« Issuer ID » affiché au-dessus du tableau (identique pour toutes les clés)
#
# La clé privée elle-même n'est PAS ici : le script la cherche dans
# ~/.appstoreconnect/private_keys/AuthKey_<ASC_KEY_ID>.p8

ASC_KEY_ID=XXXXXXXXXX
ASC_ISSUER_ID=00000000-0000-0000-0000-000000000000
