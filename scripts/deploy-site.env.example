# Copier vers scripts/deploy-site.env (non commité) et renseigner.
#
# FTP_REMOTE_DIR est le chemin du dossier « mdviewer » VU DEPUIS LA RACINE FTP,
# qui n'est pas toujours la racine du site. Selon l'hébergeur :
#   /public_html/mdviewer   ·   /www/mdviewer   ·   /httpdocs/mdviewer   ·   /mdviewer
# En cas de doute : se connecter une fois avec un client FTP et lire le chemin affiché.
# Le script vérifie la page publique après l'envoi, donc une erreur de chemin est
# détectée immédiatement plutôt que découverte plus tard.

FTP_HOST=ftp.exemple.ch
FTP_USER=utilisateur
FTP_PASSWORD=
FTP_REMOTE_DIR=/public_html/mdviewer

# Mettre à 1 seulement si l'hébergeur ne propose pas FTPS. Le mot de passe circule
# alors en clair sur le réseau.
FTP_ALLOW_PLAIN=0
