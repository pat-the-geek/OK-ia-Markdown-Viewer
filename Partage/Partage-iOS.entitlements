<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- La boîte de réception des pages partagées (`BoitePages`), dans le groupe que md Viewer partage
	     déjà avec fornews.ai. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.ai.fornews.native</string>
	</array>
</dict>
</plist>
