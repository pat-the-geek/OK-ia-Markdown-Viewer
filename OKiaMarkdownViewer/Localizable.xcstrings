    "En paysage sur iPad et grand iPhone, et dans une fenêtre large sur Mac.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En paysage sur iPad et grand iPhone, et dans une fenêtre large sur Mac."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In landscape on iPad and large iPhone, and in a wide window on Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Querformat auf iPad und großem iPhone sowie in einem breiten Fenster auf dem Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En horizontal en iPad y iPhone grande, y en una ventana ancha en Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In orizzontale su iPad e iPhone grande, e in una finestra ampia su Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPadと大きなiPhoneでは横向きのとき、Macでは幅の広いウインドウで表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPad와 큰 iPhone에서는 가로 방향일 때, Mac에서는 넓은 윈도우에서 표시됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 iPad 和大屏 iPhone 上横排时，以及在 Mac 上使用宽窗口时。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Na horizontal no iPad e no iPhone grande, e em uma janela larga no Mac."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Liggend op iPad en grote iPhone, en in een breed venster op de Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В альбомной ориентации на iPad и большом iPhone, а также в широком окне на Mac."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "В альбомній орієнтації на iPad і великому iPhone, а також у широкому вікні на Mac."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iPad’de ve büyük iPhone’da yatay konumda, Mac’te ise geniş bir pencerede."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi xoay ngang trên iPad và iPhone màn hình lớn, và trong cửa sổ rộng trên Mac."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "iPad और बड़े iPhone पर लैंडस्केप में, और Mac पर चौड़ी विंडो में।"
          }
        }
      }
    },
