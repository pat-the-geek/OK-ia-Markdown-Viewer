    "De chaque fiche, un geste vous ramène à ses mentions dans le texte.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "De chaque fiche, un geste vous ramène à ses mentions dans le texte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "From each entry, one tap takes you back to its mentions in the text."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Von jedem Eintrag führt eine Geste zurück zu seinen Erwähnungen im Text."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desde cada ficha, un gesto le lleva a sus menciones en el texto."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Da ogni scheda, un gesto vi riporta alle sue menzioni nel testo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各項目からワンタップで、本文中の言及箇所に戻れます。"
