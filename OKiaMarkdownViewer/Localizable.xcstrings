    "« %@ » sera réunie à l’entité choisie, ici et dans les autres documents.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » sera réunie à l’entité choisie, ici et dans les autres documents."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” will be merged into the chosen entity, here and in other documents."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ wird mit der gewählten Entität zusammengeführt, hier und in anderen Dokumenten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» se unirá a la entidad elegida, aquí y en los demás documentos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» sarà unita all’entità scelta, qui e negli altri documenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」は選択したエンティティに統合されます。この書類だけでなく、ほかの書類でも統合されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘%@’은(는) 선택한 개체에 병합됩니다. 이 문서와 다른 문서 모두에 적용됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”将与所选实体合并，在此处和其他文档中均生效。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” será unida à entidade escolhida, aqui e nos outros documentos."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” wordt samengevoegd met de gekozen entiteit, hier en in andere documenten."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» объединится с выбранной сущностью — здесь и в других документах."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» буде об’єднано з вибраною сутністю — тут і в інших документах."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” bu belgede ve diğer belgelerde seçilen varlıkla birleştirilecek."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” sẽ được gộp vào thực thể đã chọn, tại đây và trong các tài liệu khác."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” को चुनी गई एंटिटी में मिला दिया जाएगा, यहाँ और दूसरे दस्तावेज़ों में भी।"
          }
        }
      }
    },
