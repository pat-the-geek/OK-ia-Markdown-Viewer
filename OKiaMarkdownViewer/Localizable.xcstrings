    "Réponses générées sur l’appareil par Apple Intelligence, à partir de ce document seulement. Peuvent contenir des erreurs.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réponses générées sur l’appareil par Apple Intelligence, à partir de ce document seulement. Peuvent contenir des erreurs."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Answers generated on-device by Apple Intelligence, from this document only. May contain mistakes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Antworten auf dem Gerät von Apple Intelligence erstellt, nur aus diesem Dokument. Können Fehler enthalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Respuestas generadas en el dispositivo por Apple Intelligence, solo a partir de este documento. Pueden contener errores."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Risposte generate sul dispositivo da Apple Intelligence, solo da questo documento. Possono contenere errori."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "回答はApple Intelligenceがこの書類のみをもとにデバイス上で生成したものです。誤りが含まれる場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence가 이 문서만을 바탕으로 기기에서 생성한 답변입니다. 오류가 있을 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "回答由 Apple Intelligence 在设备上仅根据此文档生成，可能包含错误。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Respostas geradas no dispositivo pela Apple Intelligence, só a partir deste documento. Podem conter erros."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Antwoorden gegenereerd op het apparaat door Apple Intelligence, alleen op basis van dit document. Kunnen fouten bevatten."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ответы создаются на устройстве с помощью Apple Intelligence только на основе этого документа. Возможны ошибки."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відповіді створюються на пристрої за допомогою Apple Intelligence лише на основі цього документа. Можливі помилки."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yanıtlar Apple Intelligence tarafından aygıtta, yalnızca bu belgeden oluşturulur. Hata içerebilir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Câu trả lời do Apple Intelligence tạo trên thiết bị, chỉ từ tài liệu này. Có thể có sai sót."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जवाब Apple Intelligence द्वारा डिवाइस पर, केवल इसी दस्तावेज़ से जनरेट किए गए हैं। इनमें गलतियाँ हो सकती हैं।"
          }
        }
      }
    },
