    "Pour les entités que le document ne décrit pas, md Viewer peut chercher leur photo, leur description et leur position sur Wikidata. Seuls les noms partent, un par un — jamais le document, ni son titre.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour les entités que le document ne décrit pas, md Viewer peut chercher leur photo, leur description et leur position sur Wikidata. Seuls les noms partent, un par un — jamais le document, ni son titre."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For entities the document does not describe, md Viewer can look up their picture, description and location on Wikidata. Only the names are sent, one at a time — never the document, nor its title."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für Entitäten, die das Dokument nicht beschreibt, kann md Viewer Foto, Beschreibung und Standort bei Wikidata nachschlagen. Nur die Namen werden gesendet, einzeln – nie das Dokument und nie sein Titel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para las entidades que el documento no describe, md Viewer puede buscar su foto, su descripción y su ubicación en Wikidata. Solo se envían los nombres, uno a uno — nunca el documento ni su título."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per le entità che il documento non descrive, md Viewer può cercarne foto, descrizione e posizione su Wikidata. Partono solo i nomi, uno alla volta — mai il documento né il suo titolo."
          }
        }
      }
