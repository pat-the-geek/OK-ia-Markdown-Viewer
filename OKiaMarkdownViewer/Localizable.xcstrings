    "%@ — non convertie : le modèle l’a refusée": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — non convertie : le modèle l’a refusée"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — not converted: the model declined it"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — nicht umgewandelt: Das Modell hat ihn abgelehnt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — no convertida: el modelo la rechazó"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — non convertita: il modello l’ha rifiutata"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — 未変換：モデルが拒否しました"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — 변환되지 않음: 모델이 거부함"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — 未转换：模型拒绝处理"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — não convertido: o modelo recusou"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — niet omgezet: het model weigerde"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — не преобразовано: модель отказалась"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — не перетворено: модель відмовилася"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — dönüştürülmedi: model reddetti"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — chưa chuyển đổi: mô hình đã từ chối"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — रूपांतरित नहीं हुई: मॉडल ने इसे अस्वीकार किया"
          }
        }
      }
    },
    "%@ — toute la section, faute de place": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — toute la section, faute de place"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — the whole section, for lack of room"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — der ganze Abschnitt, aus Platzgründen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — toda la sección, por falta de espacio"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — l’intera sezione, per mancanza di spazio"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — スペース不足のためセクション全体を省略"
