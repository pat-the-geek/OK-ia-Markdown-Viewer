    "Apple Intelligence rédige ce que chaque commentaire demande. Le texte rédigé est ajouté et marqué comme tel ; le vôtre n’est jamais remplacé.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence rédige ce que chaque commentaire demande. Le texte rédigé est ajouté et marqué comme tel ; le vôtre n’est jamais remplacé."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence writes what each comment asks for. The written text is added and marked as such; yours is never replaced."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence verfasst, was jeder Kommentar verlangt. Der Text wird hinzugefügt und als solcher gekennzeichnet; Ihrer wird nie ersetzt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence redacta lo que pide cada comentario. El texto redactado se añade y se marca como tal; el suyo nunca se sustituye."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence scrive ciò che ogni commento chiede. Il testo scritto viene aggiunto e segnalato come tale; il vostro non viene mai sostituito."
          }
        }
      }
    },
