    "Résumé généré sur l’appareil par Apple Intelligence. Peut contenir des erreurs.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Résumé généré sur l’appareil par Apple Intelligence. Peut contenir des erreurs."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Summary generated on-device by Apple Intelligence. May contain mistakes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zusammenfassung auf dem Gerät von Apple Intelligence erstellt. Kann Fehler enthalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Resumen generado en el dispositivo por Apple Intelligence. Puede contener errores."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riassunto generato sul dispositivo da Apple Intelligence. Può contenere errori."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "要約はApple Intelligenceがデバイス上で生成したものです。誤りが含まれる場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence가 기기에서 생성한 요약입니다. 오류가 있을 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "摘要由 Apple Intelligence 在设备上生成，可能包含错误。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Resumo gerado no dispositivo pela Apple Intelligence. Pode conter erros."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Samenvatting gegenereerd op het apparaat door Apple Intelligence. Kan fouten bevatten."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Краткое содержание создано на устройстве с помощью Apple Intelligence. Возможны ошибки."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
