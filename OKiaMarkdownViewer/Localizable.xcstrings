    "« Système » : la langue de l’appareil si elle est prise en charge, anglais sinon.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Système » : la langue de l’appareil si elle est prise en charge, anglais sinon."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“System”: the device language when it is supported, English otherwise."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„System“: die Gerätesprache, sofern unterstützt, sonst Englisch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Sistema»: el idioma del dispositivo si es compatible; en caso contrario, inglés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«Sistema»: la lingua del dispositivo se supportata, altrimenti inglese."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「システム」：デバイスの言語がサポートされていればその言語、サポートされていなければ英語になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘시스템’: 기기 언어가 지원되면 기기 언어를, 그렇지 않으면 영어를 사용합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“系统”：如果支持设备语言，则使用设备语言，否则使用英语。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“Sistema”: o idioma do dispositivo, se for compatível; caso contrário, inglês."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "“Systeem”: de taal van het apparaat als die wordt ondersteund, anders Engels."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Системный»: язык устройства, если он поддерживается, иначе английский."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Системна»: мова пристрою, якщо вона підтримується, інакше англійська."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“Sistem”: destekleniyorsa aygıtın dili, değilse İngilizce."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "“Hệ thống”: ngôn ngữ của thiết bị nếu được hỗ trợ, nếu không thì dùng tiếng Anh."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "“सिस्टम”: डिवाइस की भाषा, अगर वह समर्थित है; वरना अंग्रेज़ी।"
          }
        }
      }
    },
    "Écran d’accueil": {
