            "value": "资料库和已分析的文档中都没有文档。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem o cofre nem os Documentos analisados contêm documentos."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch de kluis noch Geanalyseerde documenten bevatten documenten."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ни в хранилище, ни среди проанализированных документов нет ни одного документа."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ні в сховищі, ні серед проаналізованих документів немає жодного документа."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne kasada ne de “Analiz Edilen Belgeler” içinde belge var."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cả kho lẫn Tài liệu đã phân tích đều không chứa tài liệu nào."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "न वॉल्ट में और न ही “विश्लेषित दस्तावेज़” में कोई दस्तावेज़ है।"
          }
        }
      }
    },
