          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在每个条目中，轻点一下即可回到其在正文中被提及之处。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "De cada ficha, um toque leva você de volta às menções dela no texto."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vanuit elk item brengt één tik je terug naar de vermeldingen in de tekst."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Из любой карточки одним касанием можно перейти к упоминаниям в тексте."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "З кожної картки один дотик веде до її згадок у тексті."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her kayıttan tek dokunuşla metinde geçtiği yerlere dönersiniz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Từ mỗi mục, một lần chạm đưa bạn về những chỗ nhắc đến nó trong văn bản."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर प्रविष्टि से एक टैप में टेक्स्ट में उसके उल्लेखों पर वापस जाएँ।"
          }
        }
      }
    },
    "Un rapport fornews est exploité d’abord : ce qu’il donne n’est jamais redemandé.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un rapport fornews est exploité d’abord : ce qu’il donne n’est jamais redemandé."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A fornews report is used first: what it already gives is never looked up again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein fornews-Bericht wird zuerst ausgewertet: Was er liefert, wird nie erneut abgefragt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un informe de fornews se aprovecha primero: lo que ya da nunca se vuelve a pedir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un rapporto fornews viene sfruttato per primo: ciò che fornisce non viene mai richiesto di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "fornewsのレポートを最優先で活用します。レポートにある情報を改めて検索することはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "fornews 보고서를 가장 먼저 활용하며, 보고서에 이미 있는 정보는 다시 조회하지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "优先使用 fornews 报告：其中已提供的信息不会再次查询。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um relatório fornews é usado primeiro: o que ele já fornece nunca é buscado de novo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een fornews-rapport wordt eerst gebruikt: wat het al geeft, wordt nooit opnieuw opgezocht."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала используется отчёт fornews: то, что в нём уже есть, повторно не запрашивается."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спершу використовується звіт fornews: те, що вже є в ньому, ніколи не запитується вдруге."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önce fornews raporu kullanılır: verdiği bilgiler bir daha sorgulanmaz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Báo cáo fornews được dùng trước: những gì nó đã cung cấp sẽ không bao giờ được tra cứu lại."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहले fornews रिपोर्ट का उपयोग होता है: जो जानकारी वह देती है, उसे फिर कभी नहीं खोजा जाता।"
          }
        }
      }
    },
