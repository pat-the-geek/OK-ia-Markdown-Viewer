    "Document trop long pour être lu en entier : seul son début a été analysé.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Document trop long pour être lu en entier : seul son début a été analysé."
          }
