    "Les personnes, organisations, lieux et produits du document, rassemblés par genre.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les personnes, organisations, lieux et produits du document, rassemblés par genre."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The people, organizations, places and products in the document, gathered by kind."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Personen, Organisationen, Orte und Produkte des Dokuments, nach Art geordnet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las personas, organizaciones, lugares y productos del documento, reunidos por tipo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le persone, le organizzazioni, i luoghi e i prodotti del documento, raccolti per tipo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書類に登場する人物、組織、場所、製品を種類別にまとめます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문서에 나오는 인물, 조직, 장소, 제품을 종류별로 모아 보여줍니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文档中的人物、组织、地点和产品，按类别归类。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As pessoas, organizações, lugares e produtos do documento, agrupados por tipo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De personen, organisaties, plaatsen en producten uit het document, gegroepeerd per soort."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Люди, организации, места и продукты из документа, сгруппированные по типу."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Люди, організації, місця й продукти з документа, згруповані за типом."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Belgedeki kişiler, kuruluşlar, yerler ve ürünler, türlerine göre bir arada."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Người, tổ chức, địa điểm và sản phẩm trong tài liệu, được nhóm theo loại."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दस्तावेज़ में मौजूद व्यक्ति, संगठन, स्थान और उत्पाद, प्रकार के अनुसार एक साथ।"
          }
        }
      }
    },
