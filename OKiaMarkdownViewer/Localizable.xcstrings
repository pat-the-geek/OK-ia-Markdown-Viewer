    "Ce document ne nomme ni personne, ni organisation, ni lieu.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce document ne nomme ni personne, ni organisation, ni lieu."
          }
        },
        "en": {
          "stringUnit": {
