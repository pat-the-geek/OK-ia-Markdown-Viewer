    "Un document ouvert dans une autre langue est traduit sur l’appareil, sans rien envoyer sur le réseau. L’original reste accessible d’un geste.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un document ouvert dans une autre langue est traduit sur l’appareil, sans rien envoyer sur le réseau. L’original reste accessible d’un geste."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A document opened in another language is translated on the device, with nothing sent over the network. The original stays one tap away."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Dokument in einer anderen Sprache wird auf dem Gerät übersetzt, ohne dass etwas über das Netz geht. Das Original bleibt mit einer Geste erreichbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un documento abierto en otro idioma se traduce en el dispositivo, sin enviar nada por la red. El original queda a un gesto de distancia."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un documento aperto in un'altra lingua viene tradotto sul dispositivo, senza inviare nulla in rete. L'originale resta a portata di gesto."
          }
        }
      }
    },
