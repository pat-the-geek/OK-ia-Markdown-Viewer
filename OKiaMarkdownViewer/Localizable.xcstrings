            "value": "Surlignez, soulignez et écrivez au crayon : vos notes restent attachées au texte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Highlight, underline and write with Apple Pencil: your notes stay attached to the text."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Markieren, unterstreichen und mit dem Stift schreiben: Ihre Notizen bleiben am Text."
