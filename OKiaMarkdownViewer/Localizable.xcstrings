    "Résumé, points clés, perspectives et voix critiques, à la manière de fornews. Comptez une à deux minutes.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Résumé, points clés, perspectives et voix critiques, à la manière de fornews. Comptez une à deux minutes."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Summary, key points, outlook and critical voices, the fornews way. Allow one to two minutes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zusammenfassung, Kernpunkte, Ausblick und kritische Stimmen, wie bei fornews. Rechnen Sie mit ein bis zwei Minuten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Resumen, puntos clave, perspectivas y voces críticas, al estilo de fornews. Cuente uno o dos minutos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sintesi, punti chiave, prospettive e voci critiche, alla maniera di fornews. Contate uno o due minuti."
          }
        }
      }
    },
