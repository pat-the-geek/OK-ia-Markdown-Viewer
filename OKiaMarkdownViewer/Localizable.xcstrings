        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У звітах сховища ще ніхто не згадується."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kasadaki raporlarda henüz kimsenin adı geçmiyor."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các báo cáo trong kho chưa nêu tên ai."
          }
        },
