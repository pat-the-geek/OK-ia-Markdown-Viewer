    "Lit une page web et en fait une fiche de lecture : résumé, chiffres, noms cités.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lit une page web et en fait une fiche de lecture : résumé, chiffres, noms cités."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reads a web page and makes a reading sheet of it: summary, figures, names mentioned."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Liest eine Webseite und erstellt ein Lesedossier: Zusammenfassung, Zahlen, genannte Namen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lee una página web y hace su ficha de lectura: resumen, cifras, nombres citados."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Legge una pagina web e ne fa una scheda di lettura: riassunto, cifre, nomi citati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Webページを読んで、要約、数値、登場する名前をまとめた読書ノートを作成します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "웹 페이지를 읽고 요약, 수치, 언급된 이름을 담은 읽기 노트를 만듭니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读取网页并制作阅读卡片：摘要、数字、提及的名称。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lê uma página web e faz uma ficha de leitura dela: resumo, números, nomes citados."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Leest een webpagina en maakt er een leesoverzicht van: samenvatting, cijfers, genoemde namen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Читает веб-страницу и делает из неё конспект: краткое содержание, цифры, упомянутые имена."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Читає вебсторінку й робить із неї конспект: стислий виклад, цифри, згадані імена."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir web sayfasını okur ve ondan bir okuma kartı oluşturur: özet, rakamlar, adı geçenler."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đọc một trang web và tạo phiếu đọc: tóm tắt, số liệu, các tên được nhắc đến."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वेब पेज पढ़ता है और उसकी रीडिंग शीट बनाता है: सारांश, आँकड़े, उल्लिखित नाम।"
          }
        }
      }
    },
