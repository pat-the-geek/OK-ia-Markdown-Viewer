          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पुराने दस्तावेज़ Finder में हैं: iCloud Drive, “md Viewer” फ़ोल्डर।"
          }
        }
      }
    },
    "%@ — son texte, faute de place ; ses visuels sont repris": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — son texte, faute de place ; ses visuels sont repris"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — its text, for lack of room; its visuals are kept"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — ihr Text, aus Platzmangel; ihre Bilder und Grafiken bleiben"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — su texto, por falta de espacio; sus elementos visuales se conservan"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — il suo testo, per mancanza di spazio; i suoi elementi visivi restano"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — スペース不足のためテキストを省略（画像などは使用）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — 공간 부족으로 텍스트 제외, 시각 자료는 유지됨"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — 其文字（篇幅不足）；视觉元素已保留"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — o texto dele, por falta de espaço; os visuais são mantidos"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — de tekst, wegens ruimtegebrek; de visuals blijven behouden"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — его текст, из-за нехватки места; визуальные элементы сохранены"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — його текст, через брак місця; візуальні елементи збережено"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — yer olmadığından metni; görselleri korundu"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — phần văn bản, do không đủ chỗ; các hình ảnh trực quan được giữ lại"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — जगह की कमी के कारण उसका टेक्स्ट; उसके विज़ुअल रखे गए हैं"
          }
        }
      }
    },
    "En bref": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En bref"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In brief"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurz gefasst"
