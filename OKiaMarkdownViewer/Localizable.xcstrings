    "Résumé, points clés, perspectives et voix critiques, à la manière de fornews. Comptez une à deux minutes.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Résumé, points clés, perspectives et voix critiques, à la manière de fornews. Comptez une à deux minutes."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Summary, key points, outlook and critical voices, the fornews way. Allow one to two minutes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zusammenfassung, Kernpunkte, Ausblick und kritische Stimmen, wie bei fornews. Rechnen Sie mit ein bis zwei Minuten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Resumen, puntos clave, perspectivas y voces críticas, al estilo de fornews. Cuente uno o dos minutos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sintesi, punti chiave, prospettive e voci critiche, alla maniera di fornews. Contate uno o due minuti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "fornews形式で、要約、要点、展望、批判的な意見をまとめます。1〜2分ほどかかります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "fornews 방식의 요약, 핵심 사항, 전망, 비판적 의견. 1~2분 정도 소요됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "摘要、要点、展望与批评意见，采用 fornews 的方式。大约需要一到两分钟。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Resumo, pontos-chave, perspectivas e vozes críticas, no estilo fornews. Leva de um a dois minutos."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Samenvatting, kernpunten, vooruitzichten en kritische stemmen, op de manier van fornews. Reken op één à twee minuten."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Краткое содержание, ключевые моменты, перспективы и критические мнения — в стиле fornews. Займёт одну-две минуты."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Стислий виклад, ключові моменти, перспективи й критичні думки — у стилі fornews. Це займе одну-дві хвилини."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "fornews tarzında özet, önemli noktalar, öngörüler ve eleştirel sesler. Bir iki dakika sürer."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tóm tắt, các điểm chính, triển vọng và ý kiến phản biện, theo cách của fornews. Mất khoảng một đến hai phút."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सारांश, मुख्य बिंदु, संभावनाएँ और आलोचनात्मक दृष्टिकोण, fornews की शैली में। एक से दो मिनट लगेंगे।"
          }
        }
      }
    },
    "Sur votre Mac, avec Apple Intelligence : le document ne le quitte pas.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur votre Mac, avec Apple Intelligence : le document ne le quitte pas."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On your Mac, with Apple Intelligence: the document never leaves it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf Ihrem Mac, mit Apple Intelligence: Das Dokument verlässt ihn nicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En su Mac, con Apple Intelligence: el documento no sale de él."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sul vostro Mac, con Apple Intelligence: il documento non lo lascia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お使いのMac上でApple Intelligenceが処理します。書類がMacの外に出ることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용자의 Mac에서 Apple Intelligence로 처리하며, 문서가 Mac 밖으로 나가지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在您的 Mac 上通过 Apple Intelligence 完成：文档不会离开 Mac。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No seu Mac, com a Apple Intelligence: o documento não sai dele."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Op je Mac, met Apple Intelligence: het document verlaat hem niet."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На вашем Mac, с помощью Apple Intelligence: документ не покидает его."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На вашому Mac, за допомогою Apple Intelligence: документ не залишає його."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac’inizde, Apple Intelligence ile: belge Mac’inizden hiç çıkmaz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trên máy Mac của bạn, với Apple Intelligence: tài liệu không bao giờ rời khỏi máy."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके Mac पर, Apple Intelligence के साथ: दस्तावेज़ कभी Mac से बाहर नहीं जाता।"
          }
        }
      }
    },
