    "Tout se calcule sur l’appareil, avec Apple Intelligence : le rapport ne quitte pas l’appareil.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout se calcule sur l’appareil, avec Apple Intelligence : le rapport ne quitte pas l’appareil."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything is computed on the device with Apple Intelligence: the report never leaves it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles wird mit Apple Intelligence auf dem Gerät berechnet: Der Bericht verlässt es nicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo se calcula en el dispositivo con Apple Intelligence: el informe no sale de él."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto viene calcolato sul dispositivo con Apple Intelligence: il rapporto non lo lascia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての処理はApple Intelligenceによりデバイス上で行われます。レポートがデバイスの外に出ることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 처리는 Apple Intelligence를 통해 기기에서 이루어지며, 보고서는 기기 밖으로 나가지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一切都在设备上通过 Apple Intelligence 完成：报告不会离开设备。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo é calculado no dispositivo, com a Apple Intelligence: o relatório não sai do dispositivo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles wordt berekend op het apparaat, met Apple Intelligence: het rapport verlaat het apparaat niet."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все вычисления выполняются на устройстве с помощью Apple Intelligence: отчёт не покидает устройство."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усе обчислюється на пристрої за допомогою Apple Intelligence: звіт не залишає пристрій."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her şey aygıtta, Apple Intelligence ile hesaplanır: rapor aygıttan hiç çıkmaz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi thứ được tính toán trên thiết bị với Apple Intelligence: báo cáo không bao giờ rời khỏi thiết bị."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सब कुछ डिवाइस पर, Apple Intelligence के साथ होता है: रिपोर्ट कभी डिवाइस से बाहर नहीं जाती।"
          }
        }
      }
    },
