    "Wikidata ne répond pas : la liste reste celle du document.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Wikidata ne répond pas : la liste reste celle du document."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wikidata is not responding: the list stays as the document gives it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wikidata antwortet nicht: Die Liste bleibt so, wie das Dokument sie liefert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Wikidata no responde: la lista sigue siendo la del documento."
          }
        },
        "it": {
