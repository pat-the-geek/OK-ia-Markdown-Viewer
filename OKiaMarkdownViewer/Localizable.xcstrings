          "stringUnit": {
            "state": "translated",
            "value": "The vault’s reports don’t name anyone yet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Berichte im Store nennen noch niemanden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los informes del Store aún no nombran a nadie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I rapporti dello Store non nominano ancora nessuno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保管庫のレポートにはまだ人名が出てきません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보관함의 보고서에 아직 아무 이름도 나오지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "资料库中的报告尚未提及任何人。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os relatórios do cofre ainda não citam ninguém."
          }
        },
