        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — 整个章节（篇幅不足）"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — a seção inteira, por falta de espaço"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — de hele sectie, wegens ruimtegebrek"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — весь раздел, из-за нехватки места"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — увесь розділ, через брак місця"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — yer olmadığından bölümün tamamı"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — toàn bộ phần, do không đủ chỗ"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — जगह की कमी के कारण पूरा सेक्शन"
