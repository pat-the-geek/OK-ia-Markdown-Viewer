    "Ni le document ni Wikidata ne donnent de position à ses entités.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ni le document ni Wikidata ne donnent de position à ses entités."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Neither the document nor Wikidata gives a location for its entities."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weder das Dokument noch Wikidata nennen einen Standort für seine Entitäten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ni el documento ni Wikidata dan una ubicación a sus entidades."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Né il documento né Wikidata danno una posizione alle sue entità."
          }
        }
      }
    },
    "Le document ne donne la position d’aucune de ses entités. Wikidata peut en trouver, si vous l’acceptez.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le document ne donne la position d’aucune de ses entités. Wikidata peut en trouver, si vous l’acceptez."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The document gives no location for any of its entities. Wikidata can find some, if you allow it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Dokument nennt für keine seiner Entitäten einen Standort. Wikidata kann welche finden, wenn Sie es erlauben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El documento no da la ubicación de ninguna de sus entidades. Wikidata puede encontrar algunas, si lo acepta."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il documento non dà la posizione di nessuna delle sue entità. Wikidata può trovarne, se lo accetta."
          }
        }
      }
    },
