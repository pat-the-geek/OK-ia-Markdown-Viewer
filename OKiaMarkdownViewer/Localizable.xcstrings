    "Aucune entité du coffre n’a de position. Les fiches Wikidata déjà trouvées en donnent.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune entité du coffre n’a de position. Les fiches Wikidata déjà trouvées en donnent."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No entity in the vault has a location. Wikidata entries already found provide one."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Entität im Store hat eine Position. Bereits gefundene Wikidata-Einträge liefern sie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguna entidad del Store tiene ubicación. Las fichas de Wikidata ya encontradas la aportan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna entità dello Store ha una posizione. Le schede Wikidata già trovate la forniscono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保管庫のエンティティには位置情報がありません。すでに見つかったWikidataの項目から位置情報を取得できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보관함의 어떤 개체에도 위치 정보가 없습니다. 이미 찾은 Wikidata 항목이 위치 정보를 제공합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "资料库中没有实体具有位置信息。已找到的 Wikidata 条目可以提供位置。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma entidade do cofre tem localização. As fichas do Wikidata já encontradas fornecem uma."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen enkele entiteit in de kluis heeft een locatie. Al gevonden Wikidata-items geven er een."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ни у одной сущности хранилища нет местоположения. Его дают уже найденные карточки Wikidata."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жодна сутність сховища не має розташування. Його дають уже знайдені картки Wikidata."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kasadaki hiçbir varlığın konumu yok. Daha önce bulunan Wikidata kayıtları konum sağlar."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có thực thể nào trong kho có vị trí. Các mục Wikidata đã tìm thấy sẽ cung cấp vị trí."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वॉल्ट की किसी भी एंटिटी का स्थान नहीं है। पहले से मिली Wikidata प्रविष्टियाँ स्थान देती हैं।"
          }
        }
      }
    },
