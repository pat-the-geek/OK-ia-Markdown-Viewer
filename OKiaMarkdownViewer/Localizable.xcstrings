    "Le nom reste dans la liste, sans fiche. md Viewer ne la cherchera plus.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nom reste dans la liste, sans fiche. md Viewer ne la cherchera plus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The name stays in the list, without an entry. md Viewer won’t look it up again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Name bleibt ohne Eintrag in der Liste. md Viewer sucht ihn nicht mehr."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El nombre queda en la lista, sin ficha. md Viewer no volverá a buscarla."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il nome resta nell’elenco, senza scheda. md Viewer non la cercherà più."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前はリストに残りますが、項目はありません。md Viewerが再び検索することはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이름은 항목 없이 목록에 남습니다. md Viewer는 더 이상 이 이름을 조회하지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该名称保留在列表中，但没有条目。md Viewer 将不再查找它。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O nome continua na lista, sem ficha. O md Viewer não vai mais buscá-lo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De naam blijft in de lijst, zonder item. md Viewer zoekt hem niet meer op."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Имя остаётся в списке без карточки. md Viewer больше не будет её искать."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Назва залишається в списку без картки. md Viewer більше не шукатиме її."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ad listede kalır, kaydı olmadan. md Viewer onu bir daha aramaz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tên vẫn ở trong danh sách, không có mục. md Viewer sẽ không tra cứu lại."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नाम सूची में बना रहता है, बिना प्रविष्टि के। md Viewer इसे फिर नहीं खोजेगा।"
          }
        }
      }
    },
