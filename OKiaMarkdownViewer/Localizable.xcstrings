            "value": "Tout se calcule sur l’appareil. Wikidata n’est consulté que si vous l’acceptez, et seuls les noms partent."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything is computed on the device. Wikidata is only consulted if you allow it, and only names are sent."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles wird auf dem Gerät berechnet. Wikidata wird nur abgefragt, wenn Sie zustimmen, und nur die Namen werden gesendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo se calcula en el dispositivo. Wikidata solo se consulta si lo acepta, y solo se envían los nombres."
          }
