    "Convertit des documents Word, PDF ou PowerPoint en Markdown, les analyse et les range dans « Documents analysés ».": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Convertit des documents Word, PDF ou PowerPoint en Markdown, les analyse et les range dans « Documents analysés »."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Converts Word, PDF or PowerPoint documents to Markdown, analyzes them and files them in “Analyzed Documents”."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wandelt Word-, PDF- oder PowerPoint-Dokumente in Markdown um, analysiert sie und legt sie unter „Analysierte Dokumente“ ab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Convierte documentos Word, PDF o PowerPoint a Markdown, los analiza y los guarda en «Documentos analizados»."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Converte documenti Word, PDF o PowerPoint in Markdown, li analizza e li archivia in «Documenti analizzati»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Word、PDF、PowerPointの書類をMarkdownに変換して分析し、「分析済みの書類」に整理します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Word, PDF, PowerPoint 문서를 Markdown으로 변환하고 분석하여 ‘분석된 문서’에 정리합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将 Word、PDF 或 PowerPoint 文档转换为 Markdown，进行分析并归入“已分析的文档”。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Converte documentos Word, PDF ou PowerPoint em Markdown, analisa-os e os organiza em “Documentos analisados”."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet Word-, PDF- of PowerPoint-documenten om naar Markdown, analyseert ze en bergt ze op in “Geanalyseerde documenten”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Преобразует документы Word, PDF или PowerPoint в Markdown, анализирует их и помещает в «Проанализированные документы»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетворює документи Word, PDF або PowerPoint на Markdown, аналізує їх і розміщує в «Проаналізованих документах»."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Word, PDF veya PowerPoint belgelerini Markdown’a dönüştürür, analiz eder ve “Analiz Edilen Belgeler” klasörüne yerleştirir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chuyển tài liệu Word, PDF hoặc PowerPoint sang Markdown, phân tích và xếp chúng vào “Tài liệu đã phân tích”."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Word, PDF या PowerPoint दस्तावेज़ों को Markdown में बदलता है, उनका विश्लेषण करता है और उन्हें “विश्लेषित दस्तावेज़” में रखता है।"
          }
        }
      }
    },
