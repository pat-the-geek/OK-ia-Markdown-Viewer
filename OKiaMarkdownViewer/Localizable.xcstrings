    "Ni le document ni Wikidata ne donnent de position à ses entités.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ni le document ni Wikidata ne donnent de position à ses entités."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Neither the document nor Wikidata gives a location for its entities."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weder das Dokument noch Wikidata nennen einen Standort für seine Entitäten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ni el documento ni Wikidata dan una ubicación a sus entidades."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Né il documento né Wikidata danno una posizione alle sue entità."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書類にもWikidataにも、エンティティの位置情報がありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문서와 Wikidata 모두 개체의 위치 정보를 제공하지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文档和 Wikidata 均未提供其实体的位置。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem o documento nem o Wikidata dão uma localização para as entidades dele."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch het document noch Wikidata geeft een locatie voor de entiteiten."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ни документ, ни Wikidata не указывают местоположение его сущностей."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ні документ, ні Wikidata не вказують розташування його сутностей."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne belge ne de Wikidata, varlıkları için konum veriyor."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cả tài liệu lẫn Wikidata đều không cho biết vị trí của các thực thể."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "न दस्तावेज़ और न ही Wikidata इसकी एंटिटी का स्थान बताते हैं।"
          }
        }
      }
    },
    "Le document ne donne la position d’aucune de ses entités. Wikidata peut en trouver, si vous l’acceptez.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le document ne donne la position d’aucune de ses entités. Wikidata peut en trouver, si vous l’acceptez."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The document gives no location for any of its entities. Wikidata can find some, if you allow it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Dokument nennt für keine seiner Entitäten einen Standort. Wikidata kann welche finden, wenn Sie es erlauben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El documento no da la ubicación de ninguna de sus entidades. Wikidata puede encontrar algunas, si lo acepta."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il documento non dà la posizione di nessuna delle sue entità. Wikidata può trovarne, se lo accetta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書類にはどのエンティティの位置情報もありません。許可していただければ、Wikidataで見つけられる場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문서에 어떤 개체의 위치 정보도 없습니다. 허용하면 Wikidata에서 찾을 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文档未提供任何实体的位置。如果您允许，Wikidata 可以找到部分位置。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O documento não dá a localização de nenhuma das entidades dele. O Wikidata pode encontrar algumas, se você permitir."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het document geeft voor geen enkele entiteit een locatie. Wikidata kan er een paar vinden, als je dat toestaat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Документ не указывает местоположение ни одной из своих сущностей. Wikidata может найти его, если вы разрешите."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Документ не вказує розташування жодної зі своїх сутностей. Wikidata може його знайти, якщо ви дозволите."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Belge, varlıklarının hiçbirinin konumunu vermiyor. İzin verirseniz Wikidata bazılarını bulabilir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tài liệu không cho biết vị trí của thực thể nào. Wikidata có thể tìm được một số, nếu bạn cho phép."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दस्तावेज़ अपनी किसी भी एंटिटी का स्थान नहीं बताता। अगर आप अनुमति दें, तो Wikidata कुछ स्थान ढूँढ सकता है।"
          }
        }
      }
    },
