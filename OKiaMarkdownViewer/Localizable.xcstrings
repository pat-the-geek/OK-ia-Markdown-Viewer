    "Apple Intelligence ne prend pas encore en charge la langue de l’app : ses résumés et ses réponses viennent dans la langue choisie ici.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence ne prend pas encore en charge la langue de l’app : ses résumés et ses réponses viennent dans la langue choisie ici."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence doesn’t support the app’s language yet: its summaries and answers come in the language chosen here."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence unterstützt die Sprache der App noch nicht: Zusammenfassungen und Antworten erscheinen in der hier gewählten Sprache."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence aún no admite el idioma de la app: sus resúmenes y respuestas llegan en el idioma elegido aquí."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence non supporta ancora la lingua dell’app: riassunti e risposte arrivano nella lingua scelta qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligenceはまだアプリの言語に対応していません。要約と回答は、ここで選んだ言語で表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence가 아직 앱의 언어를 지원하지 않습니다. 요약과 답변은 여기에서 선택한 언어로 제공됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence 尚不支持此 App 的语言：摘要和回答将使用此处选择的语言。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Apple Intelligence ainda não é compatível com o idioma do app: os resumos e as respostas vêm no idioma escolhido aqui."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence ondersteunt de taal van de app nog niet: samenvattingen en antwoorden verschijnen in de taal die je hier kiest."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence пока не поддерживает язык приложения: краткие содержания и ответы будут на языке, выбранном здесь."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence поки не підтримує мову застосунку: стислі виклади та відповіді будуть мовою, вибраною тут."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence henüz uygulamanın dilini desteklemiyor: özetler ve yanıtlar burada seçilen dilde gelir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence chưa hỗ trợ ngôn ngữ của ứng dụng: bản tóm tắt và câu trả lời sẽ dùng ngôn ngữ bạn chọn ở đây."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence अभी ऐप की भाषा को सपोर्ट नहीं करता: सारांश और जवाब यहाँ चुनी गई भाषा में आते हैं।"
          }
        }
      }
    },
