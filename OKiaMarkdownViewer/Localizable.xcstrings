    "Les journaux et les sites que le document cite. Ils ne sont pas envoyés à Wikidata.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les journaux et les sites que le document cite. Ils ne sont pas envoyés à Wikidata."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The newspapers and sites the document cites. They are not sent to Wikidata."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zeitungen und Websites, die das Dokument zitiert. Sie werden nicht an Wikidata gesendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los periódicos y sitios que cita el documento. No se envían a Wikidata."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I giornali e i siti citati dal documento. Non vengono inviati a Wikidata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書類が引用している新聞やサイト。これらはWikidataには送信されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문서가 인용한 신문과 사이트입니다. Wikidata로 전송되지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文档引用的报刊和网站。它们不会被发送到 Wikidata。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os jornais e sites que o documento cita. Eles não são enviados ao Wikidata."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De kranten en sites die het document aanhaalt. Ze worden niet naar Wikidata gestuurd."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Газеты и сайты, на которые ссылается документ. Они не отправляются в Wikidata."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Газети й сайти, на які посилається документ. Вони не надсилаються до Wikidata."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Belgenin alıntı yaptığı gazeteler ve siteler. Bunlar Wikidata’ya gönderilmez."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các báo và trang web mà tài liệu trích dẫn. Chúng không được gửi đến Wikidata."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वे अख़बार और साइटें जिनका दस्तावेज़ में हवाला दिया गया है। इन्हें Wikidata पर नहीं भेजा जाता।"
          }
        }
      }
    },
