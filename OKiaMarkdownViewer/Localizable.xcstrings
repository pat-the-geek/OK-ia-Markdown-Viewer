    "Tout se calcule sur l’appareil. Wikidata n’est consulté que si vous l’acceptez, et seuls les noms partent.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout se calcule sur l’appareil. Wikidata n’est consulté que si vous l’acceptez, et seuls les noms partent."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything is computed on the device. Wikidata is only consulted if you allow it, and only names are sent."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles wird auf dem Gerät berechnet. Wikidata wird nur abgefragt, wenn Sie zustimmen, und nur die Namen werden gesendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo se calcula en el dispositivo. Wikidata solo se consulta si lo acepta, y solo se envían los nombres."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto è calcolato sul dispositivo. Wikidata viene consultato solo se lo accettate, e partono solo i nomi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての処理はデバイス上で行われます。Wikidataは許可した場合のみ参照され、送信されるのは名前だけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 처리는 기기에서 이루어집니다. Wikidata는 허용한 경우에만 조회되며, 이름만 전송됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一切都在设备上完成。只有在您允许时才会查询 Wikidata，且仅发送名称。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo é calculado no dispositivo. O Wikidata só é consultado se você permitir, e só os nomes são enviados."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles wordt berekend op het apparaat. Wikidata wordt alleen geraadpleegd als je dat toestaat, en alleen namen worden verstuurd."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все вычисления выполняются на устройстве. Wikidata используется, только если вы разрешите, и отправляются только имена."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усе обчислюється на пристрої. До Wikidata звертаються, лише якщо ви дозволите, і надсилаються тільки назви."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her şey aygıtta hesaplanır. Wikidata’ya yalnızca izin verirseniz başvurulur ve yalnızca adlar gönderilir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi thứ được tính toán trên thiết bị. Wikidata chỉ được tra cứu khi bạn cho phép, và chỉ tên được gửi đi."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सब कुछ डिवाइस पर होता है। Wikidata से केवल आपकी अनुमति से संपर्क किया जाता है, और केवल नाम भेजे जाते हैं।"
          }
        }
      }
    },
