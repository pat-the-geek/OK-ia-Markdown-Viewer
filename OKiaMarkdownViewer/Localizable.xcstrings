    "Surlignez, soulignez et écrivez au crayon : vos notes restent attachées au texte.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Surlignez, soulignez et écrivez au crayon : vos notes restent attachées au texte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Highlight, underline and write with Apple Pencil: your notes stay attached to the text."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Markieren, unterstreichen und mit dem Stift schreiben: Ihre Notizen bleiben am Text."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Resalte, subraye y escriba con el lápiz: sus notas quedan unidas al texto."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Evidenziate, sottolineate e scrivete con la matita: le note restano legate al testo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Pencilでハイライト、下線、書き込み：メモは本文に結び付いたまま保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Pencil로 하이라이트, 밑줄, 쓰기: 메모가 본문에 연결된 채로 유지됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用 Apple Pencil 高亮、划线和书写：您的笔记会始终附着在文字上。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Realce, sublinhe e escreva com o Apple Pencil: suas notas ficam presas ao texto."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Markeer, onderstreep en schrijf met de Apple Pencil: je notities blijven aan de tekst gekoppeld."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выделяйте, подчёркивайте и пишите с Apple Pencil: ваши заметки остаются привязанными к тексту."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виділяйте, підкреслюйте й пишіть за допомогою Apple Pencil: ваші нотатки залишаються прив’язаними до тексту."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Pencil ile vurgulayın, altını çizin ve yazın: notlarınız metne bağlı kalır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tô sáng, gạch chân và viết bằng Apple Pencil: ghi chú của bạn luôn gắn với văn bản."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Pencil से हाइलाइट करें, अंडरलाइन करें और लिखें: आपके नोट्स टेक्स्ट से जुड़े रहते हैं।"
          }
        }
      }
    },
    "Surlignez, soulignez et annotez à la souris ou au trackpad : vos notes restent attachées au texte.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Surlignez, soulignez et annotez à la souris ou au trackpad : vos notes restent attachées au texte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Highlight, underline and annotate with the mouse or trackpad: your notes stay attached to the text."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Markieren, unterstreichen und mit Maus oder Trackpad anmerken: Ihre Notizen bleiben am Text."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Resalte, subraye y anote con el ratón o el trackpad: sus notas quedan unidas al texto."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Evidenziate, sottolineate e annotate con mouse o trackpad: le note restano legate al testo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マウスやトラックパッドでハイライト、下線、注釈：メモは本文に結び付いたまま保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마우스나 트랙패드로 하이라이트, 밑줄, 주석: 메모가 본문에 연결된 채로 유지됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用鼠标或触控板高亮、划线和标注：您的笔记会始终附着在文字上。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Realce, sublinhe e anote com o mouse ou o trackpad: suas notas ficam presas ao texto."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Markeer, onderstreep en annoteer met de muis of het trackpad: je notities blijven aan de tekst gekoppeld."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выделяйте, подчёркивайте и комментируйте мышью или трекпадом: ваши заметки остаются привязанными к тексту."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виділяйте, підкреслюйте й анотуйте мишею або трекпадом: ваші нотатки залишаються прив’язаними до тексту."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fare veya izleme dörtgeniyle vurgulayın, altını çizin ve not ekleyin: notlarınız metne bağlı kalır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tô sáng, gạch chân và chú thích bằng chuột hoặc bàn di chuột: ghi chú của bạn luôn gắn với văn bản."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "माउस या ट्रैकपैड से हाइलाइट करें, अंडरलाइन करें और एनोटेट करें: आपके नोट्स टेक्स्ट से जुड़े रहते हैं।"
          }
        }
      }
    },
