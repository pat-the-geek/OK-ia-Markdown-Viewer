    "Achat unique, valable sur vos Mac. Sur iPhone et iPad, Analytic est un achat distinct.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Achat unique, valable sur vos Mac. Sur iPhone et iPad, Analytic est un achat distinct."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One-time purchase, valid on your Macs. On iPhone and iPad, Analytic is a separate purchase."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einmaliger Kauf, gültig auf Ihren Macs. Auf iPhone und iPad ist Analytic ein separater Kauf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compra única, válida en sus Mac. En iPhone y iPad, Analytic es una compra aparte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Acquisto unico, valido sui vostri Mac. Su iPhone e iPad, Analytic è un acquisto separato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1回限りの購入で、お使いのMacで利用できます。iPhoneとiPadでは、Analyticは別途購入が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번 구입으로 사용자의 Mac에서 사용할 수 있습니다. iPhone 및 iPad용 Analytic은 별도로 구입해야 합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一次性购买，适用于您的 Mac。在 iPhone 和 iPad 上，Analytic 需单独购买。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Compra única, válida nos seus Macs. No iPhone e no iPad, o Analytic é uma compra separada."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eenmalige aankoop, geldig op je Macs. Op iPhone en iPad is Analytic een aparte aankoop."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разовая покупка для всех ваших Mac. На iPhone и iPad Analytic покупается отдельно."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
