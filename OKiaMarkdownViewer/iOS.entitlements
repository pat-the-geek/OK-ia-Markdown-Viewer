<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Boîte aux lettres partagée avec fornews.ai — voir `BoiteAuxLettres`.
	     ⚠️ iOS n'avait AUCUN fichier d'entitlements jusqu'ici : sans celui-ci, le groupe
	     n'existe que sur le Mac et l'ouverture directe reste impossible là où on l'a demandée. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.ai.fornews.native</string>
	</array>
	<!-- Option Analytic (1.4) : annotations, corrections et cache des entités, partagés entre les
	     appareils de l'utilisateur par CloudKit, dans sa base privée (`SynchroICloud`) ; et les
	     documents que md Viewer crée, rangés dans iCloud Drive (`RangementDocuments`). -->
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.ch.ok-ia.markdownviewer</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
		<string>CloudDocuments</string>
	</array>
	<key>com.apple.developer.ubiquity-container-identifiers</key>
	<array>
		<string>iCloud.ch.ok-ia.markdownviewer</string>
	</array>
</dict>
</plist>
