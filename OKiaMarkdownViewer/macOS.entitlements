<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App Sandbox is mandatory for the Mac App Store (Catalyst build). -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Network client: map tiles (OSM/CARTO) + downloading a report over https. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Open .md files the user selects, and the vault folder. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- App-scoped security bookmarks so the vault folder + recents persist across launches. -->
	<key>com.apple.security.files.bookmarks.app-scope</key>
	<true/>
	<!-- Boîte aux lettres partagée avec fornews.ai — voir `BoiteAuxLettres`. Le groupe porte
	     l'identifiant de fornews parce que c'est lui qui l'a créé et qui le livre déjà ;
	     en créer un neutre obligerait à modifier les deux applications au lieu d'une. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.ai.fornews.native</string>
	</array>
	<!-- Option Analytic (1.4) : annotations, corrections et cache des entités, partagés entre les
	     appareils de l'utilisateur par CloudKit, dans sa base privée (`SynchroICloud`) ; et les
	     documents que md Viewer crée, rangés dans iCloud Drive (`RangementDocuments`). -->
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.ch.ok-ia.markdownviewer</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
		<string>CloudDocuments</string>
	</array>
	<key>com.apple.developer.ubiquity-container-identifiers</key>
	<array>
		<string>iCloud.ch.ok-ia.markdownviewer</string>
	</array>
</dict>
</plist>
